rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTrainer() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer';
    }

    match /sessions/{sessionId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.resource.data.athleteId == request.auth.uid;
      // Athlete can cancel their own session; trainer can update any session for their athlete
      allow update, delete: if request.auth != null &&
        (resource.data.athleteId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(resource.data.athleteId)).data.trainerId == request.auth.uid);
    }

    match /programs/{programId} {
      allow read:           if request.auth != null;
      allow create:         if request.auth != null && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        (resource.data.trainerId == request.auth.uid || isTrainer());
    }

    match /workoutLogs/{logId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.athleteId ||
        get(/databases/$(database)/documents/users/$(resource.data.athleteId)).data.trainerId == request.auth.uid ||
        isTrainer()
      );
      allow create:         if request.auth != null && request.resource.data.athleteId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.athleteId || isTrainer());
    }

    match /messages/{msgId} {
      // Only the sender or receiver can read/write
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.senderId ||
         request.auth.uid == resource.data.receiverId);
      allow create: if request.auth != null &&
        request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.receiverId; // only receiver marks read
      allow delete: if false;
    }

    match /users/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      // User can update their own doc; trainer can update docs of their athletes
      allow update: if request.auth != null &&
        (request.auth.uid == uid ||
         resource.data.trainerId == request.auth.uid ||
         (isTrainer() &&
          resource.data.role == 'athlete' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'assignedPrograms',
            'assignedProgram',
            'programStartDates',
            'programStartDate',
            'sessionsCompleted',
            'lastWorkout'
          ])));
      allow delete: if false;
    }

  }
}
